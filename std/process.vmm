import "std.vmm"




module proc {

    comptime if @target_os() == "windows" {
        extern fn CreateProcessA(u64 app, u64 cmdline, u64 pattr, u64 tattr, u32 inherit, u32 flags, u64 env, u64 cwd, u64 startup, u64 info) -> i32;
        extern fn WaitForSingleObject(u64 h, u32 ms) -> u32;
        extern fn GetExitCodeProcess(u64 h, u64 code) -> i32;
    }

    comptime if @target_os() == "windows" {

        fn zero_bytes(u8* p, u64 n) {
            u64 i = 0;
            while i < n {
                p[i] = 0;
                i = i + 1;
            }
        }

        fn str_len(u8* s) -> u64 {
            u64 n = 0;
            while s[n] != 0 {
                n = n + 1;
            }
            return n;
        }

        // appends one argument to the command line, quoted so the child's parser reads it back unchanged
        // (92 = backslash, 34 = double quote, 32 = space, 9 = tab)
        fn append_arg(u8* out, u64 pos, u8* arg) -> u64 {
            u64 len = str_len(arg);

            u64 needs_quote = 0;
            if len == 0 {
                needs_quote = 1;
            }
            u64 i = 0;
            while i < len {
                u8 c1 = arg[i];
                if c1 == 32 or c1 == 9 or c1 == 34 {
                    needs_quote = 1;
                }
                i = i + 1;
            }

            if needs_quote == 0 {
                i = 0;
                while i < len {
                    out[pos] = arg[i];
                    pos = pos + 1;
                    i = i + 1;
                }
                return pos;
            }

            out[pos] = 34;
            pos = pos + 1;

            u64 backslashes = 0;
            i = 0;
            while i < len {
                u8 c2 = arg[i];
                if c2 == 92 {
                    backslashes = backslashes + 1;
                } else if c2 == 34 {
                    // backslashes before a quote are doubled, and the quote itself is escaped
                    u64 k = 0;
                    while k < (backslashes * 2) + 1 {
                        out[pos] = 92;
                        pos = pos + 1;
                        k = k + 1;
                    }
                    out[pos] = 34;
                    pos = pos + 1;
                    backslashes = 0;
                } else {
                    u64 k2 = 0;
                    while k2 < backslashes {
                        out[pos] = 92;
                        pos = pos + 1;
                        k2 = k2 + 1;
                    }
                    out[pos] = c2;
                    pos = pos + 1;
                    backslashes = 0;
                }
                i = i + 1;
            }

            // backslashes right before the closing quote are doubled too
            u64 k3 = 0;
            while k3 < backslashes * 2 {
                out[pos] = 92;
                pos = pos + 1;
                k3 = k3 + 1;
            }
            out[pos] = 34;
            pos = pos + 1;
            return pos;
        }

        // Windows takes one command line string, not an argv array
        fn build_cmdline(u8* path, u8** args) -> u8* {
            // upper bound: each argument grows at most 2x, plus two quotes and a separator
            u64 total = 1;
            u64 n = 0;
            if (args as i64) != 0 {
                while (args[n] as i64) != 0 {
                    total = total + (str_len(args[n]) * 2) + 3;
                    n = n + 1;
                }
            }
            if n == 0 {
                total = total + (str_len(path) * 2) + 3;
            }

            u8* out = std~malloc(total as i64) as u8*;
            u64 pos = 0;
            if n == 0 {
                pos = append_arg(out, pos, path);
            } else {
                u64 i = 0;
                while i < n {
                    if i > 0 {
                        out[pos] = 32;
                        pos = pos + 1;
                    }
                    pos = append_arg(out, pos, args[i]);
                    i = i + 1;
                }
            }
            out[pos] = 0;
            return out;
        }

        // starts the program and returns its process HANDLE (on Linux the equivalent value is the pid)
        fn spawn(u8* path, u8** args) -> Result<u64, Errno> {
            u8* cmd = build_cmdline(path, args);

            // STARTUPINFOA is 104 bytes, PROCESS_INFORMATION is 24
            u8* si = std~malloc(104) as u8*;
            u8* pi = std~malloc(24) as u8*;
            zero_bytes(si, 104);
            zero_bytes(pi, 24);

            u32* si32 = si as u32*;
            u64* si64 = si as u64*;
            si32[0] = 104;              // cb
            si32[15] = 256;             // dwFlags = STARTF_USESTDHANDLES (0x100)
            si64[10] = GetStdHandle(-10);   // hStdInput
            si64[11] = GetStdHandle(-11);   // hStdOutput
            si64[12] = GetStdHandle(-12);   // hStdError

            // inherit handles = 1, so the child writes to the same stdout, like after fork()
            i32 ok = CreateProcessA(path as u64, cmd as u64, 0, 0, 1, 0, 0, 0, si as u64, pi as u64);

            u64* dbg64 = pi as u64*;
            u32* dbg32 = pi as u32*;
            
            if ok == 0 {
                Errno err = std~last_errno();       // read before any other API call
                std~free(cmd as void*);
                std~free(si as void*);
                std~free(pi as void*);
                return std~Err<u64, Errno>(err);
            }

            u64* pi64 = pi as u64*;
            u64 process = pi64[0];
            u64 thread = pi64[1];
            CloseHandle(thread);

            std~free(cmd as void*);
            std~free(si as void*);
            std~free(pi as void*);
            return std~Ok<u64, Errno>(process);
        }

        // waits for the process, returns its exit code and closes the handle
        fn wait4(u64 process) -> Result<u64, Errno> {
            u32 waited = WaitForSingleObject(process, 4294967295);     // INFINITE
            if waited != 0 {                                           // WAIT_OBJECT_0
                Errno err = std~last_errno();
                return std~Err<u64, Errno>(err);
            }

            u32 code = 0;
            i32 ok = GetExitCodeProcess(process, (&code) as u64);
            if ok == 0 {
                Errno err2 = std~last_errno();
                CloseHandle(process);
                return std~Err<u64, Errno>(err2);
            }
            CloseHandle(process);
            return std~Ok<u64, Errno>(code as u64);
        }

        fn run_cmd(u8* path, u8** args) -> i32 {
            Result<u64, Errno> started = spawn(path, args);
            u64 process = std~unwrap<u64, Errno>(started);

            Result<u64, Errno> wait_res = wait4(process);
            u64 status = std~unwrap<u64, Errno>(&wait_res);
            return status as i32;
        }

        fn run_cmd_no_wait(u8* path, u8** args) -> u64 {
            Result<u64, Errno> started = spawn(path, args);
            return std~unwrap<u64, Errno>(started);
        }

    } else {

        fn fork() -> Result<u64,Errno> {

            u64 res = std~syscall(57,0,0,0,0,0) as u64;
            return std~handle_error<u64>(res);

        }


        fn execve(u8* file_name, u8** args, u8** envp) -> Result<u64,Errno>  {


            u64 res = std~syscall(59 ,file_name as i64, args as i64, envp as i64,0,0) as u64;
            return std~handle_error<u64>(res);

        }


        fn wait4(u64 target_pid) -> Result<u64, Errno> {
            i32 status = 0;

            u64 res = std~syscall(61, target_pid as i64, (&status) as i64, 0, 0, 0) as u64;
            Result<u64, Errno> checked = std~handle_error<u64>(res);

            return std~Ok<u64, Errno>(status as u64);
        }


        fn run_cmd(u8* path, u8** args) -> i32 {
            Result<u64, Errno> res = fork();
            u64 pid = std~unwrap<u64, Errno>(res);

            if pid == 0 {
                u8* env[1];
                env[0] = 0 as u8*;
                execve(path, args, env);

                std~exit(1);
            } else {
                Result<u64, Errno> wait_res = wait4(pid);
                u64 status = std~unwrap<u64, Errno>(&wait_res);
                return status as i32;
            }
        }

        fn run_cmd_no_wait(u8* path, u8** args) -> u64 {
            Result<u64, Errno> res = fork();
            u64 pid = std~unwrap<u64, Errno>(res);

            if pid == 0 {
                u8* env[1];
                env[0] = 0 as u8*;
                execve(path, args, env);

                std~exit(1);
            } else {
                return pid;
            }
        }
    }
}