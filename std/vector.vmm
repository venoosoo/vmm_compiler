import "std.vmm"

struct Vector<T> {
    T* data;
    i64 length;
    i64 capacity;
    i64 element_size;
}


module vector {
    fn new<T>() -> *Vector<T> {
        i32 el_size = sizeof(T);
        i64 base_capacity = 8;
        T* memory = std~malloc(el_size * base_capacity) as T*;
        Vector<T>* res = std~malloc(sizeof(Vector<T>));
        res->data = memory;
        res->length = 0;
        res->capacity = base_capacity;
        res->element_size = el_size;
        return res;
    }
    
    fn push<T>(Vector<T>* vec, T element) {
        if vec->length == vec->capacity {
            i64 new_capacity = vec->capacity * 2;
            T* new_data = std~malloc(new_capacity * vec->element_size);
            std~memcpy(new_data, vec->data, vec->length * vec->element_size);
            vec->data = new_data;
            vec->capacity = new_capacity;
        }
        T* dest = vec->data + vec->length;
        std~memcpy(dest, &element, vec->element_size);
        vec->length = vec->length + 1;
    }
    
    
    fn pop<T>(Vector<T>* vec) -> T {
        if vec->length == 0 {
            std~exit(1);
        }
        vec->length = vec->length - 1;
        T* element = vec->data + vec->length;
        return *element;
    }
    
    fn get_element<T>(Vector<T>* vec, i64 element_pos) -> T {
        if vec->length <= element_pos {
            std~print("trying to get element: ");
            std~print(element_pos);
            std~print(", but vector size is: ");
            std~println(vec->length);
            std~exit(1);
        }
        T* element = vec->data + element_pos;
        return *element;
    }
    
    fn set_element<T>(Vector<T>* vec, i64 element_pos, T element) {
        if vec->length <= element_pos {
            println("Error: Vector set out of bounds");
            std~exit(1);
        }
        T* dest = vec->data + element_pos;
        
        // Using memcpy completely bypasses any compiler assignment bugs!
        std~memcpy(dest, &element, vec->element_size);
    }
}



fn main() {
    std~println("loha lox");
}